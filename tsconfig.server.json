{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "rootDir": "src/server",
    "outDir": "dist/server",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/server"],
  "exclude": ["src/server/**/*.test.ts"]
}
